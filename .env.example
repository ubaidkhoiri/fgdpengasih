# Neon dashboard → project → Connect → copy pooled connection string
# lalu paste ganti baris bawah. File ini contoh, aman di-commit.
# File asli: .env (gitignored), isi sama, user paste di sana.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=require
# Kode rahasia admin chat. Buat acak, min 12 karakter. Jangan sebar.
# Produksi: npx wrangler secret put ADMIN_CODE
ADMIN_CODE=GANTI_DENGAN_KODE_ACAK_MIN_12_KARAKTER
